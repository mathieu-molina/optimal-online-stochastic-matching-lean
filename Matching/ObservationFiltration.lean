import Matching.PosteriorTrace
import Mathlib.Probability.Process.Filtration

/-! The observation filtration generated by the execution's completion log:
at time t one sees initial history and exactly the log entries dated at most t.
Joint measurability is proved, as is monotonicity of the information in time.
Identification of the running posterior rate with this filtration is separate.
-/

open MeasureTheory Set

namespace StochasticMatching

variable {J : Type*} [MeasurableSpace J]

def completionEntryTime : Unit ⊕ (J × ℝ × ℝ) → ℝ :=
  Sum.elim (fun _ => 0) (fun x => x.2.1)

theorem measurable_completionEntryTime : Measurable (completionEntryTime (J := J)) :=
  Measurable.sumElim measurable_const (measurable_fst.comp measurable_snd)

noncomputable def censorLog (t : ℝ) (L : CompletionLog J) : CompletionLog J := by
  classical
  exact fun r => if completionEntryTime (L r) ≤ t then L r else Sum.inl ()

theorem measurable_censorLog : Measurable (fun x : ℝ × CompletionLog J => censorLog x.1 x.2) := by
  apply measurable_pi_lambda
  intro r
  have he : Measurable (fun x : ℝ × CompletionLog J => x.2 r) :=
    (measurable_pi_apply r).comp measurable_snd
  exact Measurable.ite (measurableSet_le (measurable_completionEntryTime.comp he) measurable_fst)
    he measurable_const

theorem censorLog_censorLog {s t : ℝ} (hst : s ≤ t) (L : CompletionLog J) :
    censorLog s (censorLog t L) = censorLog s L := by
  classical
  funext r
  by_cases ht : completionEntryTime (L r) ≤ t
  · simp only [censorLog, if_pos ht]
  · have hs : ¬ completionEntryTime (L r) ≤ s := fun h => ht (h.trans hst)
    simp only [censorLog, if_neg ht, if_neg hs, ite_self]

variable {Ω A : Type*} [mΩ : MeasurableSpace Ω] [MeasurableSpace A]

noncomputable def observedAt (X : Ω → A) (L : Ω → CompletionLog J) (t : ℝ) (ω : Ω) :
    A × CompletionLog J := (X ω, censorLog t (L ω))

theorem measurable_observedAt {X : Ω → A} (hX : Measurable X)
    {L : Ω → CompletionLog J} (hL : Measurable L) :
    Measurable (fun x : ℝ × Ω => observedAt X L x.1 x.2) :=
  (hX.comp measurable_snd).prodMk (measurable_censorLog.comp
    (measurable_fst.prodMk (hL.comp measurable_snd)))

noncomputable def completionFiltration {X : Ω → A} (hX : Measurable X)
    {L : Ω → CompletionLog J} (hL : Measurable L) : Filtration ℝ mΩ where
  seq t := (inferInstance : MeasurableSpace (A × CompletionLog J)).comap (observedAt X L t)
  le' t := ((measurable_observedAt hX hL).comp (measurable_const.prodMk measurable_id)).comap_le
  mono' := by
    intro s t hst
    have hG : Measurable (fun x : A × CompletionLog J => (x.1, censorLog s x.2)) :=
      measurable_fst.prodMk (measurable_censorLog.comp (measurable_const.prodMk measurable_snd))
    have hcomp := hG.comp (comap_measurable (observedAt X L t))
    have hmeas : @Measurable Ω (A × CompletionLog J)
        ((inferInstance : MeasurableSpace (A × CompletionLog J)).comap (observedAt X L t))
        inferInstance (observedAt X L s) := by
      simpa only [Function.comp_def, observedAt, censorLog_censorLog hst] using hcomp
    exact hmeas.comap_le

namespace PosteriorStage

variable {H ι : Type*} [MeasurableSpace H] [Fintype ι] [DecidableEq ι]

noncomputable def observationFiltration (s : PosteriorStage H ι) (label : ι → J) :
    Filtration ℝ (inferInstance : MeasurableSpace (H × (ι → ℝ))) :=
  completionFiltration measurable_fst (s.measurable_completionLog label)

theorem observationFiltration_mono (s : PosteriorStage H ι) (label : ι → J) {a b : ℝ}
    (hab : a ≤ b) : s.observationFiltration label a ≤ s.observationFiltration label b :=
  (s.observationFiltration label).mono hab

end PosteriorStage
end StochasticMatching
