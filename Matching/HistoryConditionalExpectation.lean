import Matching.HistoryTransport
import Mathlib.MeasureTheory.Function.ConditionalExpectation.Basic

/-! Identify conditional expectations from the residual-product law.
Conditioning is on the sigma-algebra generated by the observed history.
-/

open MeasureTheory Set
open scoped ENNReal BigOperators

namespace StochasticMatching

variable {H ι : Type*} [MeasurableSpace H] [Fintype ι]

theorem conditionalExpectation_history_product (ν : Measure H) [IsFiniteMeasure ν]
    (f : H × (ι → ℝ) → ℝ) (hf : Measurable f)
    (hfi : Integrable f (ν.prod independentExponentials)) :
    (fun x : H × (ι → ℝ) => ∫ z, f (x.1, z) ∂independentExponentials) =ᵐ[
      ν.prod independentExponentials]
      (ν.prod independentExponentials)[f | (‹MeasurableSpace H›).comap Prod.fst] := by
  let g : H → ℝ := fun h => ∫ z, f (h, z) ∂independentExponentials
  have hg : StronglyMeasurable g := hf.stronglyMeasurable.integral_prod_right'
  have hfst : Measure.map (Prod.fst : H × (ι → ℝ) → H)
      (ν.prod independentExponentials) = ν := by simp
  have hgi : Integrable (fun x : H × (ι → ℝ) => g x.1) (ν.prod independentExponentials) := by
    have h : Integrable g (Measure.map (Prod.fst : H × (ι → ℝ) → H)
        (ν.prod independentExponentials)) := by
      rw [hfst]
      exact hfi.integral_prod_left
    exact h.comp_measurable measurable_fst
  apply ae_eq_condExp_of_forall_setIntegral_eq measurable_fst.comap_le hfi
    (fun _ _ _ => hgi.integrableOn)
  · rintro _ ⟨s, hs, rfl⟩ _
    have heq : (Prod.fst : H × (ι → ℝ) → H) ⁻¹' s = s ×ˢ univ := by
      ext x
      simp
    rw [heq, ← Measure.restrict_prod_eq_prod_univ]
    have hfir : Integrable f ((ν.restrict s).prod independentExponentials) := by
      rw [Measure.restrict_prod_eq_prod_univ]
      exact hfi.restrict
    have hgir : Integrable (fun x : H × (ι → ℝ) => g x.1)
        ((ν.restrict s).prod independentExponentials) := by
      rw [Measure.restrict_prod_eq_prod_univ]
      exact hgi.restrict
    rw [integral_prod _ hgir, integral_prod _ hfir]
    simp only [integral_const, measureReal_univ_eq_one, one_smul]
    rfl
  · exact (hg.comp_measurable (comap_measurable Prod.fst)).aestronglyMeasurable

end StochasticMatching
