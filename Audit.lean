  let env ← getEnv
  for name in names do
    match env.checked.get.find? name with
    | some (.thmInfo _) => pure ()
    | _ => throwError "Missing theorem declaration: {name}"
  -- Use Lean's standard axiom collector with one shared visited set. This
  -- computes the union of dependencies for every theorem without rescanning
  -- the same mathlib proof graph separately for each theorem.
  let (_, state) := ((names.forM CollectAxioms.collect).run env).run {}
  let allowed : Array Name := #[`propext, `Classical.choice, `Quot.sound]
  for axiomName in state.axioms do
    unless allowed.contains axiomName do
      throwError "Unexpected axiom dependency: {axiomName}"
  logInfo m!"Audited theorem/lemma declarations: {names.size}"
  logInfo m!"Union of axiom dependencies: {state.axioms}"

